#include <windows.h>
#include "version.h"

1 VERSIONINFO
FILEVERSION AT_VERSION_RESOURCE
PRODUCTVERSION AT_VERSION_RESOURCE
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AudioTrace"
            VALUE "FileVersion", AT_VERSION
            VALUE "InternalName", "AudioTrace"
            VALUE "OriginalFilename", "AudioTrace.exe"
            VALUE "ProductName", "AudioTrace"
            VALUE "ProductVersion", AT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
